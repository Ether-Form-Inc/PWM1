# Writes fw_version.h with the firmware version and the git commit it was built from. Run at every build (cmake -P) so
# the commit is current; the file is only rewritten when its content changes.
#
# Inputs: SRC_DIR (the repository), OUT (the header to write), MAJOR, MINOR, PATCH

set(commit "")
set(dirty 0)
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SRC_DIR} rev-parse --short=8 HEAD
                  OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    set(commit "")
  else()
    # Uncommitted changes to tracked files mean the binary is not exactly that commit
    execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SRC_DIR} status --porcelain --untracked-files=no
                    OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(changes)
      set(dirty 1)
    endif()
  endif()
endif()

set(version "${MAJOR}.${MINOR}.${PATCH}")
if(commit)
  set(commit_hex "0x${commit}u")
  set(version "${version}+${commit}")
  if(dirty)
    set(version "${version}-dirty")
  endif()
else()
  set(commit_hex "0u")
endif()

set(content
"// Generated by cmake/gen_version.cmake. Do not edit.
#pragma once
#define FW_VERSION_MAJOR ${MAJOR}
#define FW_VERSION_MINOR ${MINOR}
#define FW_VERSION_PATCH ${PATCH}
#define FW_VCS_COMMIT ${commit_hex}
#define FW_VCS_DIRTY ${dirty}
#define FW_VERSION_STRING \"${version}\"
")
set(old "")
if(EXISTS ${OUT})
  file(READ ${OUT} old)
endif()
if(NOT old STREQUAL content)
  get_filename_component(dir ${OUT} DIRECTORY)
  file(MAKE_DIRECTORY ${dir})
  file(WRITE ${OUT} "${content}")
endif()
